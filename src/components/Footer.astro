---
import { ArrowUpRight, Mail, MapPin, Phone } from "@lucide/astro";
import { site } from "../data/site";
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <p class="footer-kicker">LPKP MENTARI</p>
      <h2>Keterampilan untuk langkah kerja yang lebih pasti.</h2>
    </div>
    <div>
      <p class="footer-title">Hubungi</p>
      <a href={site.maps} target="_blank" rel="noreferrer"><MapPin size={17} aria-hidden="true" /> {site.address}</a>
      <a href={`mailto:${site.email}`}><Mail size={17} aria-hidden="true" /> {site.email}</a>
      <a href={site.whatsapp} target="_blank" rel="noreferrer"><Phone size={17} aria-hidden="true" /> {site.phoneDisplay}</a>
    </div>
    <div>
      <p class="footer-title">Akses cepat</p>
      <a href={site.links.course} target="_blank" rel="noreferrer">Online Course <ArrowUpRight size={16} aria-hidden="true" /></a>
      <a href={site.links.lms} target="_blank" rel="noreferrer">LMS <ArrowUpRight size={16} aria-hidden="true" /></a>
      <a href={site.links.blog} target="_blank" rel="noreferrer">Berita Blog <ArrowUpRight size={16} aria-hidden="true" /></a>
      <a href={site.links.marketplace} target="_blank" rel="noreferrer">Marketplace <ArrowUpRight size={16} aria-hidden="true" /></a>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>&copy; {new Date().getFullYear()} LPKP Mentari</span>
    <span>NPSN K5666768 &middot; NILEK 07207.1.0024</span>
  </div>
</footer>

<style>
  .site-footer {
    padding: 72px 0 24px;
    color: #dbe5ee;
    background: #091a30;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 0.65fr;
    gap: 72px;
    padding-bottom: 62px;
  }

  .footer-kicker,
  .footer-title {
    margin-bottom: 14px;
    color: #f0c758;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-brand h2 {
    max-width: 560px;
    margin-bottom: 0;
    color: #fff;
    font-size: clamp(1.7rem, 3vw, 3rem);
  }

  .footer-grid > div:not(.footer-brand) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 13px;
  }

  .footer-grid a {
    display: inline-flex;
    align-items: flex-start;
    gap: 8px;
    color: inherit;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .footer-grid a:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .footer-grid svg {
    flex: 0 0 auto;
    margin-top: 4px;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding-top: 24px;
    color: #97aabc;
    font-size: 0.78rem;
    border-top: 1px solid rgb(255 255 255 / 14%);
  }

  @media (max-width: 840px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 42px 28px;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-brand {
      grid-column: auto;
    }

    .footer-bottom {
      flex-direction: column;
    }
  }
</style>
