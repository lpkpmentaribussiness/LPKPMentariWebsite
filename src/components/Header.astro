---
import { Image } from "astro:assets";
import { ArrowUpRight, Menu, X } from "@lucide/astro";
import logo from "../assets/logomentari.png";
import { site } from "../data/site";

const currentPath = Astro.url.pathname;
const navItems = [
  { href: "/", label: "Beranda" },
  { href: "/tentang.html", label: "Tentang" },
  { href: "/kontak.html", label: "Kontak" },
];

const isActive = (href: string) => currentPath === href;
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="LPKP Mentari, beranda">
      <Image src={logo} alt="" width={50} height={35} loading="eager" />
      <span><strong>LPKP</strong> MENTARI</span>
    </a>

    <nav class="desktop-nav" aria-label="Navigasi utama">
      {navItems.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
      ))}
      <a href={site.links.course} target="_blank" rel="noreferrer">
        Online Course <ArrowUpRight size={15} stroke-width={2} aria-hidden="true" />
      </a>
    </nav>

    <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Buka menu" data-menu-button>
      <Menu class="menu-open-icon" size={23} aria-hidden="true" />
      <X class="menu-close-icon" size={23} aria-hidden="true" />
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <nav class="container" aria-label="Navigasi mobile">
      {navItems.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
      ))}
      <a href={site.links.course} target="_blank" rel="noreferrer">Online Course <ArrowUpRight size={18} aria-hidden="true" /></a>
      <a href={site.links.lms} target="_blank" rel="noreferrer">LMS <ArrowUpRight size={18} aria-hidden="true" /></a>
      <a href={site.links.blog} target="_blank" rel="noreferrer">Berita Blog <ArrowUpRight size={18} aria-hidden="true" /></a>
      <a href={site.links.marketplace} target="_blank" rel="noreferrer">Marketplace <ArrowUpRight size={18} aria-hidden="true" /></a>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-menu-button]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");

  const closeMenu = () => {
    if (!button || !menu) return;
    button.setAttribute("aria-expanded", "false");
    button.setAttribute("aria-label", "Buka menu");
    menu.hidden = true;
    document.body.classList.remove("menu-open");
  };

  button?.addEventListener("click", () => {
    if (!menu) return;
    const willOpen = button.getAttribute("aria-expanded") !== "true";
    button.setAttribute("aria-expanded", String(willOpen));
    button.setAttribute("aria-label", willOpen ? "Tutup menu" : "Buka menu");
    menu.hidden = !willOpen;
    document.body.classList.toggle("menu-open", willOpen);
  });

  window.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth > 860) closeMenu();
  });
</script>

<style>
  .site-header {
    position: absolute;
    z-index: 20;
    top: 0;
    left: 0;
    width: 100%;
    color: #fff;
    border-bottom: 1px solid rgb(255 255 255 / 22%);
    background: rgb(9 26 48 / 38%);
    backdrop-filter: blur(14px);
  }

  .header-inner {
    display: flex;
    min-height: 78px;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: inherit;
    font-size: 0.98rem;
    text-decoration: none;
  }

  .brand img {
    width: 46px;
    height: 38px;
    object-fit: contain;
  }

  .brand strong {
    color: #f0c758;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .desktop-nav a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 7px 0;
    color: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current="page"] {
    border-color: #f0c758;
  }

  .menu-button {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    color: inherit;
    border: 1px solid rgb(255 255 255 / 42%);
    border-radius: 4px;
    background: transparent;
    cursor: pointer;
  }

  .menu-close-icon {
    display: none;
  }

  .menu-button[aria-expanded="true"] .menu-open-icon {
    display: none;
  }

  .menu-button[aria-expanded="true"] .menu-close-icon {
    display: block;
  }

  .mobile-menu {
    position: fixed;
    inset: 78px 0 0;
    min-height: calc(100dvh - 78px);
    color: #fff;
    background: #091a30;
  }

  .mobile-menu nav {
    display: grid;
    padding-top: 24px;
  }

  .mobile-menu a {
    display: flex;
    min-height: 54px;
    align-items: center;
    justify-content: space-between;
    color: inherit;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid rgb(255 255 255 / 14%);
  }

  @media (max-width: 860px) {
    .desktop-nav {
      display: none;
    }

    .menu-button {
      display: inline-flex;
    }
  }
</style>
