---
import { Image, Picture } from "astro:assets";
import { ArrowRight, Award, BookOpenCheck, Building2, CircleCheckBig, MonitorUp, ShieldCheck } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactCta from "../components/ContactCta.astro";
import hero from "../assets/fotobanner.jpg";
import p1 from "../assets/prestasi01.jpg";
import p2 from "../assets/prestasi02.jpg";
import p3 from "../assets/prestasi03.jpg";
import p4 from "../assets/prestasi04.jpg";
import p5 from "../assets/prestasi05.jpg";
import p6 from "../assets/prestasi06.jpg";
import p7 from "../assets/prestasi07.jpg";
import { achievements, programs, site } from "../data/site";

const gallery = [p1, p2, p3, p4, p5, p6, p7];
const strengths = [
  { icon: ShieldCheck, title: "Terakreditasi B", text: "Akreditasi BAN-PNF tahun 2017 untuk program keahlian komputer." },
  { icon: BookOpenCheck, title: "Kurikulum Matang", text: "Pembelajaran diarahkan pada keterampilan terapan dan standar kompetensi kerja." },
  { icon: Building2, title: "Fasilitas Pelatihan", text: "Lingkungan belajar yang mendukung praktik dan pengembangan keterampilan." },
];
---

<BaseLayout
  title={site.name}
  description="LPKP Mentari adalah lembaga kursus dan pelatihan kerja di Tebing Tinggi untuk komputer, akuntansi, tata boga, menjahit, dan keterampilan profesional."
>
  <section class="hero" aria-labelledby="hero-title">
    <Picture
      src={hero}
      formats={["avif", "webp"]}
      widths={[640, 960, 1280, 1600]}
      sizes="100vw"
      quality={70}
      alt="Peserta dan pengelola LPKP Mentari di depan lokasi pelatihan"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <p class="hero-kicker">Lembaga Kursus &amp; Pelatihan Kerja &middot; Sejak 2001</p>
      <h1 id="hero-title">LPKP MENTARI</h1>
      <p class="hero-lead">{site.slogan}</p>
      <div class="hero-actions">
        <a class="button button--primary" href={site.whatsapp} target="_blank" rel="noreferrer">Konsultasi Program <ArrowRight size={18} aria-hidden="true" /></a>
        <a class="button button--secondary" href="/tentang.html">Kenali Lembaga</a>
      </div>
    </div>
    <div class="hero-facts" aria-label="Identitas lembaga">
      <div class="container hero-facts-inner">
        <div><span>Berdiri</span><strong>2001</strong></div>
        <div><span>Akreditasi</span><strong>B</strong></div>
        <div><span>NPSN</span><strong>K5666768</strong></div>
        <div><span>Lokasi</span><strong>Tebing Tinggi</strong></div>
      </div>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="strength-title">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="eyebrow">Dasar kepercayaan</p>
          <h2 id="strength-title">Pelatihan yang berakar pada kompetensi.</h2>
        </div>
        <p>LPKP Mentari dibina oleh kementerian terkait dan menjalankan pendidikan keterampilan yang dekat dengan kebutuhan kerja.</p>
      </div>
      <div class="strength-grid">
        {strengths.map(({ icon: Icon, title, text }, index) => (
          <article class="strength-item reveal">
            <div class="strength-number">0{index + 1}</div>
            <Icon size={27} stroke-width={1.8} aria-hidden="true" />
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section programs" aria-labelledby="program-title">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="eyebrow">Pilihan program</p>
          <h2 id="program-title">Keterampilan untuk kerja dan wirausaha.</h2>
        </div>
        <p>Program disusun untuk membangun kemampuan praktis pada bidang yang dibutuhkan peserta dan dunia kerja.</p>
      </div>
      <div class="program-list">
        {programs.map((program, index) => (
          <article class="program-item reveal">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3>{program.title}</h3>
              <p>{program.description}</p>
            </div>
            <CircleCheckBig size={22} aria-hidden="true" />
          </article>
        ))}
      </div>
      <a class="text-link program-link" href={site.links.course} target="_blank" rel="noreferrer">Lihat Online Course <MonitorUp size={18} aria-hidden="true" /></a>
    </div>
  </section>

  <section class="section facility section--white" aria-labelledby="facility-title">
    <div class="container facility-grid">
      <div class="facility-copy reveal">
        <p class="eyebrow">Lingkungan belajar</p>
        <h2 id="facility-title">Belajar melalui praktik yang terarah.</h2>
        <p>Fasilitas pelatihan LPKP Mentari mendukung proses belajar keterampilan, mulai dari pembelajaran komputer hingga pengembangan kompetensi untuk kerja dan usaha mandiri.</p>
        <a class="text-link" href="/kontak.html">Kunjungi lokasi <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
      <div class="facility-media reveal">
        <Image src={p7} alt="Dokumentasi fasilitas pelatihan LPKP Mentari" widths={[420, 720, 960]} sizes="(max-width: 760px) 100vw, 48vw" />
        <div class="facility-note"><Award size={22} aria-hidden="true" /><span>Pelatihan sejak 2001</span></div>
      </div>
    </div>
  </section>

  <section class="section achievements" aria-labelledby="achievement-title">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="eyebrow">Rekam jejak</p>
          <h2 id="achievement-title">Prestasi dan pengabdian yang terdokumentasi.</h2>
        </div>
        <p>Penghargaan lembaga dan pengelola menjadi bagian dari perjalanan LPKP Mentari melayani masyarakat Tebing Tinggi.</p>
      </div>
      <div class="gallery">
        {achievements.map((item, index) => (
          <figure class:list={["gallery-item", "reveal", { "gallery-item--wide": index === 0 || index === 5 }]}>
            <a href={gallery[index].src} target="_blank" aria-label={`Lihat ${item.title}`}>
              <Image src={gallery[index]} alt={item.title} widths={[360, 640, 900]} sizes="(max-width: 700px) 100vw, 33vw" />
            </a>
            <figcaption>
              <span>{item.year}</span>
              <strong>{item.title}</strong>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <ContactCta />
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: flex;
    min-height: 92svh;
    align-items: flex-end;
    overflow: hidden;
    color: #fff;
    background: #091a30;
  }

  .hero :global(picture),
  .hero :global(picture img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero :global(picture img) {
    object-fit: cover;
    object-position: center 35%;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgb(9 26 48 / 68%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding-bottom: 150px;
  }

  .hero-kicker {
    margin-bottom: 18px;
    color: #f0c758;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero h1 {
    margin-bottom: 12px;
    color: #fff;
  }

  .hero-lead {
    max-width: 680px;
    margin-bottom: 30px;
    color: #e4ecf3;
    font-size: clamp(1rem, 1.7vw, 1.28rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-facts {
    position: absolute;
    z-index: 2;
    right: 0;
    bottom: 0;
    left: 0;
    border-top: 1px solid rgb(255 255 255 / 24%);
    background: rgb(9 26 48 / 72%);
    backdrop-filter: blur(10px);
  }

  .hero-facts-inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .hero-facts-inner > div {
    display: flex;
    min-height: 82px;
    flex-direction: column;
    justify-content: center;
    padding: 14px 22px;
    border-right: 1px solid rgb(255 255 255 / 18%);
  }

  .hero-facts span {
    color: #abc0d1;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .hero-facts strong {
    font-size: 1rem;
  }

  .strength-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .strength-item {
    position: relative;
    padding: 34px 34px 32px 0;
    border-right: 1px solid var(--line);
  }

  .strength-item + .strength-item {
    padding-left: 34px;
  }

  .strength-item:last-child {
    padding-right: 0;
    border-right: 0;
  }

  .strength-number {
    position: absolute;
    top: 30px;
    right: 28px;
    color: var(--ink-soft);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .strength-item svg {
    margin-bottom: 20px;
    color: var(--teal);
  }

  .strength-item h3 {
    margin-bottom: 10px;
  }

  .strength-item p {
    margin-bottom: 0;
    color: var(--ink-soft);
    font-size: 0.93rem;
  }

  .programs {
    background: #edf1f4;
  }

  .program-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 44px;
    border-top: 1px solid #cbd3da;
  }

  .program-item {
    display: grid;
    grid-template-columns: 38px 1fr 28px;
    gap: 14px;
    align-items: start;
    padding: 24px 0;
    border-bottom: 1px solid #cbd3da;
  }

  .program-item > span {
    color: var(--teal);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .program-item h3 {
    margin-bottom: 6px;
  }

  .program-item p {
    margin-bottom: 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .program-item svg {
    color: var(--gold);
  }

  .program-link {
    margin-top: 30px;
  }

  .facility-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 76px;
    align-items: center;
  }

  .facility-copy p:not(.eyebrow) {
    margin-bottom: 24px;
    color: var(--ink-soft);
  }

  .facility-media {
    position: relative;
    min-height: 480px;
    overflow: hidden;
  }

  .facility-media :global(img) {
    width: 100%;
    height: 560px;
    object-fit: cover;
    object-position: center 42%;
  }

  .facility-note {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 20px 24px;
    color: var(--navy-deep);
    background: var(--gold);
    font-weight: 800;
  }

  .achievements {
    background: #e8edf1;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .gallery-item {
    margin: 0;
    overflow: hidden;
    background: #fff;
  }

  .gallery-item--wide {
    grid-column: span 2;
  }

  .gallery-item a {
    display: block;
    overflow: hidden;
  }

  .gallery-item :global(img) {
    width: 100%;
    height: 260px;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .gallery-item--wide :global(img) {
    height: 330px;
  }

  .gallery-item a:hover :global(img) {
    transform: scale(1.025);
  }

  .gallery-item figcaption {
    display: grid;
    gap: 5px;
    padding: 18px 20px 20px;
  }

  .gallery-item figcaption span {
    color: var(--teal);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .gallery-item figcaption strong {
    line-height: 1.38;
  }

  @media (max-width: 900px) {
    .hero-facts-inner {
      grid-template-columns: repeat(2, 1fr);
    }

    .hero-facts-inner > div {
      min-height: 62px;
    }

    .strength-grid,
    .facility-grid {
      grid-template-columns: 1fr;
    }

    .strength-item,
    .strength-item + .strength-item {
      padding: 28px 0;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .strength-item:last-child {
      border-bottom: 0;
    }

    .facility-grid {
      gap: 36px;
    }

    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 650px) {
    .hero {
      min-height: 780px;
    }

    .hero :global(picture img) {
      object-position: 58% center;
    }

    .hero-overlay {
      background: rgb(9 26 48 / 72%);
    }

    .hero-content {
      padding-bottom: 170px;
    }

    .hero-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .hero-actions .button {
      width: 100%;
    }

    .program-list,
    .gallery {
      grid-template-columns: 1fr;
    }

    .gallery-item--wide {
      grid-column: auto;
    }

    .gallery-item :global(img),
    .gallery-item--wide :global(img) {
      height: 250px;
    }

    .facility-media,
    .facility-media :global(img) {
      min-height: 0;
      height: 420px;
    }
  }
</style>
