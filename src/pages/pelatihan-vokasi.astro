---
import { ArrowRight, CircleCheckBig, GraduationCap, MonitorUp, ShieldCheck, Sparkles, Wrench } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactCta from "../components/ContactCta.astro";
import { programs, site } from "../data/site";
---

<BaseLayout
  title="Pelatihan Vokasi Keterampilan Kerja"
  description="11 Program Pelatihan Keterampilan Vokasi LPKP Mentari Kota Tebing Tinggi: Komputer Office, Teknisi Akuntansi, Tata Boga, Menjahit, Salon Rias, Pengelasan, Teknisi Komputer, Handphone, Jaringan, Web Desain, Desain Grafis."
>
  <header class="page-hero">
    <div class="container">
      <p class="eyebrow">Pelatihan Vokasi LPKP Mentari</p>
      <h1>Pilihan Program Pelatihan Keterampilan Vokasi Siap Kerja.</h1>
      <p>Kurikulum vokasi terarah berstandar kompetensi kerja, dirancang untuk membangun keahlian praktis dan kemandirian wirausaha dalam waktu fleksibel di Kota Tebing Tinggi.</p>
    </div>
  </header>

  <!-- Banner Referensi Program 1 Tahun -->
  <section class="section pro-callout-section">
    <div class="container">
      <div class="pro-callout-box reveal">
        <div class="pro-callout-text">
          <span class="pro-callout-badge"><Sparkles size={15} aria-hidden="true" /> Program Pendidikan 1 Tahun</span>
          <h2>Mencari Pendidikan Komputer Intensif 1 Tahun Lengkap dengan Asrama?</h2>
          <p>Tersedia Program Profesional 1 Tahun Komputer dengan fasilitas tempat tinggal / asrama gratis dan makan 3x sehari untuk membina karir dan wirausaha mandiri.</p>
        </div>
        <a class="button button--secondary" href="/pendidikan-kursus.html">
          Lihat Pendidikan Kursus 1 Tahun <ArrowRight size={18} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <!-- 11 Program Pelatihan Vokasi Kejuruan -->
  <section class="section section--white" id="program-kejuruan" aria-labelledby="vocational-title">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="eyebrow">Daftar Kejuruan Resmi</p>
          <h2 id="vocational-title">11 Program Pelatihan Keterampilan Vokasi.</h2>
        </div>
        <p>Program kursus terstruktur dengan komposisi 70% praktik langsung dan 30% teori terapan untuk mempersiapkan peserta memasuki dunia kerja maupun membuka usaha mandiri.</p>
      </div>

      <div class="vocation-grid">
        {programs.map((program, index) => (
          <article class="vocation-card reveal">
            <div class="vocation-card-header">
              <span class="vocation-num">{String(index + 1).padStart(2, "0")}</span>
              <span class="vocation-badge">Siap Kerja &amp; Wirausaha</span>
            </div>
            <div class="vocation-card-body">
              <h3>{program.title}</h3>
              <p>{program.description}</p>
            </div>
            <div class="vocation-card-footer">
              <a
                class="vocation-action"
                href={`https://wa.me/6281370007002?text=${encodeURIComponent(`Halo LPKP Mentari, saya ingin konsultasi pendaftaran Pelatihan Vokasi: ${program.title}.`)}`}
                target="_blank"
                rel="noreferrer"
              >
                <span>Daftar / Konsultasi</span>
                <ArrowRight size={16} aria-hidden="true" />
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Metode & Keunggulan Pelatihan Vokasi -->
  <section class="section advantages" aria-labelledby="advantages-title">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="eyebrow">Metode Pembelajaran</p>
          <h2 id="advantages-title">Standar Kualitas Pelatihan Vokasi LPKP Mentari.</h2>
        </div>
        <p>Didukung pengalaman menyelenggarakan pendidikan dan pelatihan keterampilan kerja sejak 2001 di Kota Tebing Tinggi.</p>
      </div>

      <div class="advantages-grid">
        <div class="advantage-card reveal">
          <div class="advantage-icon"><CircleCheckBig size={26} aria-hidden="true" /></div>
          <h3>70% Praktik Langsung</h3>
          <p>Fokus pada latihan teknis di laboratorium dan bengkel kerja agar peserta terbiasa menyelesaikan tugas sesuai standar kerja industri.</p>
        </div>
        <div class="advantage-card reveal">
          <div class="advantage-icon"><ShieldCheck size={26} aria-hidden="true" /></div>
          <h3>Terakreditasi &amp; Legalitas Resmi</h3>
          <p>Terakreditasi B (BAN-PNF 2017), memiliki NPSN K5666768, dan teregistrasi resmi di Kementerian Pendidikan serta Kementerian Tenaga Kerja (VIN 1911127401).</p>
        </div>
        <div class="advantage-card reveal">
          <div class="advantage-icon"><Wrench size={26} aria-hidden="true" /></div>
          <h3>Fasilitas Praktik Terpadu</h3>
          <p>Laboratorium komputer AC, bengkel las standar keselamatan kerja, studio jahit, dan perlengkapan tata rias lengkap untuk menunjang pembelajaran optimal.</p>
        </div>
        <div class="advantage-card reveal">
          <div class="advantage-icon"><GraduationCap size={26} aria-hidden="true" /></div>
          <h3>Sertifikat Resmi &amp; Portofolio</h3>
          <p>Lulusan menerima sertifikat resmi lembaga dan bimbingan penyusunan portofolio karya untuk melamar pekerjaan atau memulai wirausaha mandiri.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Online Course Callout -->
  <section class="section online-callout section--white" aria-labelledby="online-title">
    <div class="container">
      <div class="online-box reveal">
        <div class="online-content">
          <p class="eyebrow">Fleksibilitas Belajar Daring</p>
          <h2 id="online-title">Ingin Belajar Keterampilan Secara Online?</h2>
          <p>LPKP Mentari juga menyediakan platform pembelajaran daring bersertifikat resmi. Akses materi video interaktif, kuis praktik, dan ujian sertifikasi kapan saja dari perangkat Anda.</p>
          <a class="button button--primary" href={site.links.course} target="_blank" rel="noreferrer">
            Buka Mentari Online Course <MonitorUp size={18} aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <ContactCta />
</BaseLayout>

<style>
  /* Banner Referensi Program 1 Tahun */
  .pro-callout-section {
    padding: 40px 0 0;
  }

  .pro-callout-box {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    align-items: center;
    justify-content: space-between;
    padding: 36px 44px;
    border: 1px solid #c9d5e0;
    border-radius: 18px;
    background: linear-gradient(135deg, #091a30 0%, #102a4c 55%, #0b7479 100%);
    color: #ffffff;
    box-shadow: 0 12px 32px -8px rgb(9 26 48 / 12%);
  }

  .pro-callout-text {
    max-width: 680px;
  }

  .pro-callout-badge {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    padding: 5px 12px;
    margin-bottom: 14px;
    color: #091a30;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-radius: 999px;
    background: #f0c758;
  }

  .pro-callout-text h2 {
    margin: 0 0 10px;
    color: #ffffff;
    font-size: 1.45rem;
    line-height: 1.25;
  }

  .pro-callout-text p {
    margin: 0;
    color: #d6e3ee;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  /* Grid 11 Kejuruan */
  .vocation-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
    gap: 28px;
    margin-top: 44px;
  }

  .vocation-card {
    display: flex;
    flex-direction: column;
    padding: 28px;
    border: 1px solid #dce2e8;
    border-radius: 16px;
    background: #ffffff;
    box-shadow: 0 4px 16px -4px rgb(9 26 48 / 5%);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .vocation-card:hover {
    transform: translateY(-4px);
    border-color: #0b7479;
    box-shadow: 0 14px 28px -8px rgb(11 116 121 / 15%);
  }

  .vocation-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .vocation-num {
    color: #0b7479;
    font-size: 0.92rem;
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .vocation-badge {
    padding: 4px 10px;
    color: #091a30;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    border-radius: 999px;
    background: #f4e7bd;
  }

  .vocation-card-body {
    flex: 1;
  }

  .vocation-card-body h3 {
    margin: 0 0 10px;
    color: #172339;
    font-size: 1.2rem;
    line-height: 1.35;
  }

  .vocation-card-body p {
    margin: 0 0 20px;
    color: #4c596d;
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .vocation-card-footer {
    padding-top: 16px;
    border-top: 1px solid #eef2f6;
  }

  .vocation-action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #0b7479;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    transition: color 0.15s ease, gap 0.15s ease;
  }

  .vocation-action:hover {
    color: #085559;
    gap: 12px;
  }

  /* Keunggulan & Metode */
  .advantages {
    background: #f4f7fa;
  }

  .advantages-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 28px;
    margin-top: 48px;
  }

  .advantage-card {
    padding: 32px 28px;
    border: 1px solid #dce2e8;
    border-radius: 16px;
    background: #ffffff;
    box-shadow: 0 4px 16px -4px rgb(9 26 48 / 5%);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .advantage-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 24px -6px rgb(9 26 48 / 10%);
  }

  .advantage-icon {
    display: grid;
    width: 52px;
    height: 52px;
    place-items: center;
    margin-bottom: 20px;
    color: #0b7479;
    border-radius: 12px;
    background: #e3f2f3;
  }

  .advantage-card h3 {
    margin: 0 0 10px;
    color: #172339;
    font-size: 1.15rem;
    line-height: 1.35;
  }

  .advantage-card p {
    margin: 0;
    color: #4c596d;
    font-size: 0.88rem;
    line-height: 1.55;
  }

  /* Online Callout */
  .online-callout {
    padding-bottom: 80px;
  }

  .online-box {
    padding: 48px;
    border: 1px solid #dce2e8;
    border-radius: 20px;
    background: linear-gradient(135deg, #f8fafc 0%, #edf2f7 100%);
  }

  .online-content {
    max-width: 680px;
  }

  .online-content h2 {
    margin: 8px 0 14px;
    color: #172339;
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
  }

  .online-content p {
    margin: 0 0 24px;
    color: #4c596d;
    font-size: 0.98rem;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .pro-callout-box {
      padding: 28px 24px;
      flex-direction: column;
      align-items: flex-start;
    }

    .vocation-grid {
      grid-template-columns: 1fr;
    }

    .online-box {
      padding: 32px 24px;
    }
  }
</style>
